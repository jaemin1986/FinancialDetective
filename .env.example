# 이 파일을 복사해 .env 를 만들고 실제 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# OpenDART (https://opendart.fss.or.kr) 인증키 40자리
DART_API_KEY=

# 공공데이터포털 (https://www.data.go.kr) "금융위원회_주식시세정보" 일반 인증키 (Decoding 키 권장)
DATA_GO_KR_API_KEY=

# Supabase (Phase 3에서 입력)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
